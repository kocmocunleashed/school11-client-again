{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/news",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/teachers",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/achievements",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/courses",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/applications",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/settings",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
