{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "bun install",
  "buildCommand": "bun run build",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/admin",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/news",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/teachers",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/achievements",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/courses",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/applications",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    },
    {
      "source": "/admin/settings",
      "missing": [
        {
          "type": "cookie",
          "key": "school11_admin"
        }
      ],
      "destination": "/admin/login",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/login",
      "destination": "/api/admin/login.ts"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin/logout.ts"
    },
    {
      "source": "/api/admin/me",
      "destination": "/api/admin/me.ts"
    },
    {
      "source": "/api/admin/debug",
      "destination": "/api/admin/debug.ts"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/.*).*)",
      "destination": "/index.html"
    }
  ]
}
